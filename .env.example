# Copy to .env (optional). All values below are the defaults.

# Where Whisper stores downloaded model weights (default: ~/.cache/whisper)
# WHISPER_MODEL_DIR=./models

# Force a device: cpu | cuda | mps (default: auto-detect cuda, else cpu)
# WHISPER_DEVICE=cpu

# Audio validation limits
# MAX_AUDIO_SECONDS=600
# MIN_AUDIO_SECONDS=0.5
# SILENCE_RMS_THRESHOLD=0.001
